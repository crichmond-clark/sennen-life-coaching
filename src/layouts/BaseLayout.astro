---
import NavBar from '../components/NavBar.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface SocialLink {
  platform: 'Instagram' | 'TikTok' | 'LinkedIn' | 'Facebook' | 'X'
  url: string
}

interface Settings {
  brandName: string
  tagline: string
  siteUrl: string
  bookingUrl: string
  socialLinks: SocialLink[]
}

interface Props {
  title: string
  description: string
  settings: Settings
  path?: string
  image?: string
}

const { title, description, settings, path = Astro.url.pathname, image = '/images/og-image.jpg' } = Astro.props
const canonical = new URL(path, settings.siteUrl).toString()
const imageUrl = new URL(image, settings.siteUrl).toString()
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={settings.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body class="bg-background text-on-background text-body-md antialiased overflow-x-hidden selection:bg-primary-container selection:text-on-primary-container min-h-screen flex flex-col">
    <NavBar brandName={settings.brandName} bookingUrl={settings.bookingUrl} socialLinks={settings.socialLinks} />
    <main class="flex-grow flex flex-col pt-[72px]">
      <slot />
    </main>
    <Footer brandName={settings.brandName} tagline={settings.tagline} socialLinks={settings.socialLinks} />
  </body>
</html>
