---
import BotanicalDivider from './BotanicalDivider.astro'

interface Testimonial {
  id: string
  data: {
    quote: string
    authorName: string
    authorTitle?: string
  }
}

interface Props {
  testimonials: Testimonial[]
  showDividers?: boolean
  liftedMiddle?: boolean
}

const { testimonials, showDividers = true, liftedMiddle = true } = Astro.props
---

{testimonials.length > 0 && (
  <section class="py-section-gap px-container-padding bg-surface-container-low relative">
    {showDividers && (
      <div class="w-full h-16 flex justify-center items-center opacity-30 mb-8">
        <BotanicalDivider />
      </div>
    )}

    <div class="max-w-7xl mx-auto w-full">
      <div class="text-center mb-16 space-y-4">
        <span class="text-label-caps text-secondary tracking-widest uppercase block">Testimonials</span>
        <h2 class="text-headline-lg text-primary">What Clients Say</h2>
        <p class="text-body-lg text-on-surface-variant font-light max-w-2xl mx-auto">
          Stories from those who have walked this path with me.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {testimonials.map((testimonial, index) => (
          <article
            class:list={[
              'bg-surface-container-lowest p-10 rounded-3xl shadow-sm border border-outline-variant/30 relative overflow-hidden group',
              liftedMiddle && index === 1 ? 'md:-translate-y-4' : '',
            ]}
          >
            <div class="absolute top-6 left-6 text-[80px] text-secondary/10 font-serif leading-none" aria-hidden="true">&ldquo;</div>
            <p class="text-body-lg text-on-surface font-light leading-relaxed mb-8 relative z-10">
              &ldquo;{testimonial.data.quote}&rdquo;
            </p>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center">
                <span class="text-body-md text-secondary font-medium">
                  {testimonial.data.authorName.charAt(0)}
                </span>
              </div>
              <div>
                <p class="text-body-md font-medium text-on-surface">{testimonial.data.authorName}</p>
                {testimonial.data.authorTitle && (
                  <p class="text-label-caps text-on-surface-variant tracking-widest uppercase">{testimonial.data.authorTitle}</p>
                )}
              </div>
            </div>
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary/20 via-primary to-primary/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </article>
        ))}
      </div>
    </div>

    {showDividers && (
      <div class="w-full h-16 flex justify-center items-center opacity-30 mt-16">
        <BotanicalDivider direction="down" />
      </div>
    )}
  </section>
)}
