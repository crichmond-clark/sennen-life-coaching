---
interface Props {
  direction?: 'up' | 'down'
}

const { direction = 'up' } = Astro.props
const curve = direction === 'up' ? 'M10 12C30 12 40 2 60 2C80 2 90 12 110 12' : 'M10 12C30 12 40 22 60 22C80 22 90 12 110 12'
const circleY = direction === 'up' ? 2 : 22
const leaf = direction === 'up' ? 'M55 7C55 7 58 4 60 2C62 4 65 7 65 7' : 'M55 17C55 17 58 20 60 22C62 20 65 17 65 17'
---

<svg fill="none" height="24" viewBox="0 0 120 24" width="120" xmlns="http://www.w3.org/2000/svg" class="text-primary" aria-hidden="true">
  <path d={curve} stroke="currentColor" stroke-linecap="round" stroke-width="1"></path>
  <circle cx="60" cy={circleY} fill="currentColor" r="2"></circle>
  <path d={leaf} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1"></path>
</svg>
