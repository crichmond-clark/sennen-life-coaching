---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPage, getSiteSettings, getTestimonials } from '../lib/content'

const settings = await getSiteSettings()
const page = await getPage('testimonials')
const testimonials = await getTestimonials()
---

<BaseLayout title={page.data.seoTitle} description={page.data.seoDescription} settings={settings}>
  <div class="w-full relative flex flex-col flex-grow">
    <section class="bg-surface-container py-section-gap px-container-padding relative overflow-hidden -mt-[72px] pt-[150px]">
      <div class="absolute inset-0 bg-texture opacity-50 mix-blend-multiply"></div>
      <div class="max-w-3xl mx-auto text-center relative z-10 space-y-6">
        {page.data.hero.eyebrow && <span class="text-label-caps text-secondary tracking-widest uppercase block">{page.data.hero.eyebrow}</span>}
        <h1 class="text-display-xl text-primary leading-tight">{page.data.hero.heading}</h1>
        <p class="text-body-lg text-on-surface-variant font-light max-w-2xl mx-auto">{page.data.hero.subtitle}</p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-container-padding py-section-gap w-full">
      {testimonials.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {testimonials.map((testimonial) => (
            <article class="bg-surface-container-lowest p-10 rounded-3xl shadow-sm border border-outline-variant/30 relative overflow-hidden group">
              <div class="absolute top-6 left-6 text-[80px] text-secondary/10 font-serif leading-none" aria-hidden="true">&ldquo;</div>
              <p class="text-body-lg text-on-surface font-light leading-relaxed mb-8 relative z-10">&ldquo;{testimonial.data.quote}&rdquo;</p>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center">
                  <span class="text-body-md text-secondary font-medium">{testimonial.data.authorName.charAt(0)}</span>
                </div>
                <div>
                  <p class="text-body-md font-medium text-on-surface">{testimonial.data.authorName}</p>
                  {testimonial.data.authorTitle && <p class="text-label-caps text-on-surface-variant tracking-widest uppercase">{testimonial.data.authorTitle}</p>}
                </div>
              </div>
              <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary/20 via-primary to-primary/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </article>
          ))}
        </div>
      ) : (
        <div class="max-w-3xl mx-auto text-center space-y-4">
          <h2 class="text-headline-md text-primary">Testimonials coming soon</h2>
          <p class="text-body-lg text-on-surface-variant font-light">This page will be updated when real client testimonials are available.</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
