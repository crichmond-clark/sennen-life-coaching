---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPage, getServices, getSiteSettings } from '../lib/content'

const settings = await getSiteSettings()
const page = await getPage('services')
const services = await getServices()
const sections = page.data.sections as any
---

<BaseLayout title={page.data.seoTitle} description={page.data.seoDescription} settings={settings}>
  <div class="w-full relative flex flex-col flex-grow">
    <section class="bg-surface-container py-section-gap px-container-padding relative overflow-hidden -mt-[72px] pt-[150px]">
      <div class="absolute inset-0 bg-texture opacity-50 mix-blend-multiply"></div>
      <div class="max-w-4xl mx-auto text-center relative z-10 space-y-6">
        {page.data.hero.eyebrow && <span class="text-label-caps text-secondary tracking-widest uppercase">{page.data.hero.eyebrow}</span>}
        <h1 class="text-display-xl text-primary leading-tight">{page.data.hero.heading}</h1>
        <p class="text-body-lg text-on-surface-variant font-light mx-auto max-w-2xl">{page.data.hero.subtitle}</p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-container-padding py-section-gap w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div class="aspect-square relative organic-shape-3 overflow-hidden shadow-lg group">
          <img src={sections.philosophyImage} alt={sections.philosophyImageAlt} class="w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-[2000ms] ease-out" loading="lazy" />
        </div>
        <div class="space-y-6">
          <h2 class="text-headline-md text-primary">{sections.philosophyHeading}</h2>
          {(sections.philosophyBody ?? []).map((paragraph: string) => (
            <p class="text-body-md text-on-surface-variant font-light leading-relaxed">{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-surface py-section-gap px-container-padding">
      <div class="max-w-7xl mx-auto w-full grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((service) => (
          <article class="bg-surface-container-lowest rounded-3xl p-10 shadow-sm border border-outline-variant/30 hover:shadow-md transition-all duration-300 flex flex-col hover:-translate-y-2 relative group overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-transparent via-primary-fixed to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <h3 class="text-headline-md text-primary mb-2 relative z-10">{service.data.title}</h3>
            <div class="flex items-baseline gap-2 mb-6 relative z-10">
              <span class="text-headline-md text-secondary">{service.data.price}</span>
              <span class="text-label-caps text-on-surface-variant tracking-widest uppercase">/ {service.data.duration}</span>
            </div>
            <p class="text-body-md text-on-surface font-light mb-8 relative z-10 flex-grow">{service.data.summary}</p>
            <div class="h-px w-full bg-outline-variant/50 mb-8"></div>
            <ul class="space-y-4 mb-10 relative z-10 flex-grow">
              {service.data.features.map((feature) => (
                <li class="flex gap-3 text-body-md text-on-surface-variant font-light">
                  <span class="text-primary">•</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <a href={service.data.ctaHref} class="w-full py-4 text-center border-2 border-primary text-primary text-label-caps uppercase tracking-widest rounded-full hover:bg-primary hover:text-on-primary transition-colors duration-300 relative z-10 block">
              {service.data.ctaText}
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="max-w-3xl mx-auto text-center px-container-padding py-section-gap w-full space-y-6">
      <h2 class="text-headline-md text-primary">{sections.customHeading}</h2>
      <p class="text-body-lg text-on-surface-variant font-light">{sections.customBody}</p>
      <a href={sections.customCtaHref ?? '/booking'} class="inline-block mt-4 text-secondary text-label-caps uppercase tracking-widest border-b border-secondary pb-1 hover:text-primary hover:border-primary transition-colors">
        {sections.customCtaText}
      </a>
    </section>
  </div>
</BaseLayout>
