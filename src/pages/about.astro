---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPage, getSiteSettings } from '../lib/content'

const settings = await getSiteSettings()
const about = await getPage('about')
const sections = about.data.sections as any
const journey = sections?.journey ?? []
const philosophyCards = sections?.philosophyCards ?? []

function iconSvg(iconName: string) {
  const common = 'class="w-16 h-16 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" aria-hidden="true"'
  const icons: Record<string, string> = {
    Flower: `<svg ${common}><path d="M12 22s8-4 8-10a4 4 0 0 0-8 0 4 4 0 0 0-8 0c0 6 8 10 8 10Z"/><path d="M12 22V12"/></svg>`,
    Droplet: `<svg ${common}><path d="M12 22a7 7 0 0 0 7-7c0-5-7-13-7-13S5 10 5 15a7 7 0 0 0 7 7Z"/></svg>`,
    Leaf: `<svg ${common}><path d="M11 20A7 7 0 0 1 4 13C4 5 12 3 20 3c0 8-2 16-10 16Z"/><path d="M4 20c4-4 8-8 16-17"/></svg>`,
    Sun: `<svg ${common}><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2m10-10h-2M4 12H2m17.07-7.07-1.41 1.41M6.34 17.66l-1.41 1.41m14.14 0-1.41-1.41M6.34 6.34 4.93 4.93"/></svg>`,
    Heart: `<svg ${common}><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>`,
  }

  return icons[iconName] ?? icons.Flower
}
---

<BaseLayout title={about.data.seoTitle} description={about.data.seoDescription} settings={settings}>
  <div class="w-full relative flex flex-col flex-grow">
    <section class="relative w-full min-h-[85vh] flex items-center justify-center px-container-padding mb-section-gap -mt-[72px]">
      <div class="absolute inset-0 z-0">
        <img src={about.data.hero.image ?? '/images/about-hero.jpg'} alt={about.data.hero.imageAlt ?? ''} class="w-full h-full object-cover opacity-80" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto text-center mt-20">
        {about.data.hero.eyebrow && <span class="text-label-caps text-secondary mb-4 block tracking-widest uppercase">{about.data.hero.eyebrow}</span>}
        <h1 class="text-display-xl text-primary mb-6">{about.data.hero.heading}</h1>
        <p class="text-body-lg text-on-surface-variant max-w-2xl mx-auto font-light leading-relaxed">{about.data.hero.subtitle}</p>
      </div>
    </section>

    {journey.map((section: any, index: number) => (
      <section class="max-w-7xl mx-auto px-container-padding mb-section-gap w-full">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-center">
          <div class:list={['relative group', index % 2 === 1 ? 'md:col-start-8 md:col-span-5' : 'md:col-span-5 md:col-start-2']}>
            <div class="aspect-[3/4] relative organic-shape-1 overflow-hidden shadow-lg border-4 border-surface-container-highest">
              <img src={section.image ?? '/images/journey.jpg'} alt={section.imageAlt ?? section.heading} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1200ms]" loading="lazy" />
            </div>
            <div class="absolute -z-10 -bottom-10 -left-10 w-64 h-64 bg-surface-container-high rounded-full opacity-50 blur-2xl"></div>
          </div>
          <div class:list={['space-y-8 mt-12 md:mt-0', index % 2 === 1 ? 'md:col-span-5 md:col-start-2' : 'md:col-span-5 md:col-start-8']}>
            <h2 class="text-headline-lg text-primary leading-tight">{section.heading}</h2>
            <p class="text-body-md text-on-surface-variant font-light leading-relaxed whitespace-pre-line">{section.body}</p>
          </div>
        </div>
      </section>
    ))}

    <section class="bg-surface-container-low py-section-gap px-container-padding mb-section-gap relative">
      <div class="max-w-7xl mx-auto w-full">
        <div class="text-center mb-16 space-y-4">
          <h2 class="text-headline-lg text-primary">{sections.philosophyHeading}</h2>
          <p class="text-body-lg text-on-surface-variant font-light">{sections.philosophySubtitle}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
          {philosophyCards.map((card: any, index: number) => (
            <article class:list={['bg-surface-container-lowest p-8 rounded-2xl shadow-sm border border-outline-variant/30 hover:shadow-md transition-shadow duration-300 relative overflow-hidden group', index === 1 ? 'md:-translate-y-8' : '']}>
              <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <Fragment set:html={iconSvg(card.iconName)} />
              </div>
              <h3 class="text-headline-md text-secondary mb-4">{card.title}</h3>
              <p class="text-body-md text-on-surface font-light leading-relaxed relative z-10">{card.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-container-padding mb-section-gap w-full">
      <h2 class="text-headline-md text-primary text-center mb-16">{sections.galleryHeading}</h2>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-7">
          <div class="aspect-[4/3] organic-shape-2 overflow-hidden shadow-md group">
            <img src="/images/yoga-shala.jpg" alt="Calm indoor coaching space" class="w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-[2000ms] ease-out" loading="lazy" />
          </div>
        </div>
        <div class="md:col-span-5 flex flex-col gap-8">
          <div class="aspect-[3/2] organic-shape-3 overflow-hidden shadow-md w-4/5 ml-auto group">
            <img src="/images/ceramics.jpg" alt="A quiet cup of tea" class="w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-[2000ms] ease-out" loading="lazy" />
          </div>
          <div class="aspect-square rounded-full overflow-hidden shadow-md w-3/5 mr-auto border-8 border-surface-container relative group">
            <img src="/images/meditation.jpg" alt="Quiet time outdoors" class="w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-[2000ms] ease-out" loading="lazy" />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
