{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sennen/botanical-divider",
  "title": "Botanical Divider",
  "category": "sennen-sections",
  "description": "A decorative botanical SVG divider to separate page sections.",
  "supports": {
    "anchor": true,
    "spacing": { "margin": true, "padding": true }
  },
  "attributes": {
    "variant": { "type": "string", "default": "up" },
    "opacity": { "type": "number", "default": 30 }
  },
  "render": "file:./render.php"
}
