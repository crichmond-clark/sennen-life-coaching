{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sennen/about-journey-sections",
  "title": "About Journey Sections",
  "category": "sennen-sections",
  "description": "Alternating text/image sections for the About page journey.",
  "supports": { "html": false, "align": false },
  "attributes": {
    "sections": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "body": { "type": "string" },
          "imageUrl": { "type": "string" }
        }
      }
    }
  },
  "render": "file:./render.php"
}
